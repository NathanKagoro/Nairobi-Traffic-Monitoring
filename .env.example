# Copy to .env for local runs. Never commit the real .env.
# In GitHub Actions these come from repository secrets instead.

# TomTom API key - https://developer.tomtom.com/user/me/apps
TOMTOM_API_KEY=your_tomtom_api_key_here

# Supabase project URL and service_role key.
# Dashboard:  https://supabase.com/dashboard/projects
# Both values: Project Settings -> API  (or Settings -> API Keys)
#              https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Which city to collect for. Selects config/cities/<CITY>.json.
# Available: dar_es_salaam, nairobi
CITY=dar_es_salaam

# Optional overrides
# COLLECTION_INTERVAL_MINUTES=30
# LOCAL_UTC_OFFSET_HOURS=3
